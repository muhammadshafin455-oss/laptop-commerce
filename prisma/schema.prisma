generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderType {
  DELIVERY
  SELF_PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  REJECTED
  CANCELLED
}

model Charger {
  id          String      @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  price       Decimal     @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(5, 2)
  stock       Int         @default(0)
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  image       ChargerImage?
}

/**
 * Uploaded product photos live in their own table so catalogue queries never
 * drag image bytes into memory. Served through /api/charger-image/[id].
 */
model ChargerImage {
  id        String   @id @default(cuid())
  chargerId String   @unique
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt
  charger   Charger  @relation(fields: [chargerId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Order {
  id             String      @id @default(cuid())
  userId         String?
  customerName   String
  customerEmail  String?
  customerPhone  String
  deliveryAddress String?
  orderType      OrderType
  deliveryFee    Decimal     @default(0) @db.Decimal(10, 2)
  subtotal       Decimal     @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  status         OrderStatus @default(PENDING)
  rejectionNote  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerPhone])
  @@index([customerEmail])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  chargerId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  charger   Charger @relation(fields: [chargerId], references: [id])

  @@index([orderId])
  @@index([chargerId])
}

enum NotificationAudience {
  ADMIN
  CUSTOMER
}

enum NotificationKind {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_PACKING
  ORDER_READY
  ORDER_OUT_FOR_DELIVERY
  ORDER_COMPLETED
  ORDER_REJECTED
  ORDER_CANCELLED
}

/**
 * An in-app message for the shop or a customer. Customer rows carry both the
 * account id (when there is one) and the order's phone number, so a guest can
 * still be matched to their notifications.
 */
model Notification {
  id        String               @id @default(cuid())
  audience  NotificationAudience
  kind      NotificationKind
  title     String
  body      String
  orderId   String?
  userId    String?
  phone     String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([audience, readAt])
  @@index([userId])
  @@index([phone])
  @@index([orderId])
}

model StoreSetting {
  id          String   @id @default(cuid())
  deliveryFee Decimal  @default(0) @db.Decimal(10, 2)
  // Shown to customers who choose self pickup, so they know where to collect.
  shopName    String?
  shopAddress String?
  shopPhone   String?
  pickupHours String?
  updatedAt   DateTime @updatedAt
}
